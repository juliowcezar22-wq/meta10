# ============================================================
# META 10 — variáveis de ambiente
# Copie para .env.local (dev) e cadastre na Vercel (produção).
# NUNCA commite valores reais.
# ============================================================

# --- Supabase (obrigatórias; server + client) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key
# Usada apenas por scripts administrativos locais (nunca no app/client):
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key

# --- Contato e redes (opcionais; client) ---
# WHATSAPP é o destino das vendas enquanto não houver checkout Hotmart
NEXT_PUBLIC_WHATSAPP_NUMBER=5575981122334
NEXT_PUBLIC_INSTAGRAM_LINK=https://instagram.com/meta10espacopedagogico
NEXT_PUBLIC_YOUTUBE_LINK=https://www.youtube.com/@meta10quiz
NEXT_PUBLIC_EMAIL_LINK=mailto:contato@meta10.com.br

# --- Checkout Hotmart (opcionais; client) ---
# Vazias ou com "placeholder" => botões de assinatura caem no WhatsApp
NEXT_PUBLIC_HOTMART_MENSAL=
NEXT_PUBLIC_HOTMART_ANUAL=

# --- Seed do admin (configurada no banco, não aqui; ver supabase/seeds) ---
# ADMIN_SEED_EMAIL é definida via "ALTER DATABASE ... SET app.admin_seed_email"
